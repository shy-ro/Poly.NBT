<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>Poly.NBT</PackageId>
        <VersionPrefix>0.1.0</VersionPrefix>
        <Title>Poly.NBT</Title>
        <Description>PolyType-based serialization for the Java and Bedrock NBT wire formats, with SNBT text support.</Description>
        <Authors>shy-ro</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageTags>nbt;minecraft;serialization;polytype;aot;snbt</PackageTags>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/shy-ro/Poly.NBT</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- Symbols and source stepping. Source Link itself needs no package: the .NET SDK bundles the GitHub
         provider and turns it on unless a Microsoft.SourceLink package is referenced, so a PDB built here
         already maps every tracked source file to raw.githubusercontent.com at the packed commit. These
         properties add the package shape and the reproducibility. A local build keeps its own paths, because
         that is what the debugger needs to read the working tree; a CI build normalizes them to /_/ so the
         published PDB does not depend on where it was built. -->
    <PropertyGroup>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PolyType" Version="1.4.1" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
        <None Include="../LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
