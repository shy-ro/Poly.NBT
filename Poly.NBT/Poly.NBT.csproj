<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsAotCompatible>true</IsAotCompatible>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <!-- Packaging metadata. There is deliberately no PackageLicenseExpression: the repository has no license
         file, and naming one here would assert a choice the project has not made. Add both together when it
         does. VersionPrefix stays below 1.0 until the API has shipped. -->
    <PropertyGroup>
        <PackageId>Poly.NBT</PackageId>
        <VersionPrefix>0.1.0</VersionPrefix>
        <Title>Poly.NBT</Title>
        <Description>PolyType-based, Native AOT-friendly serialization for the Java and Bedrock NBT wire formats, with SNBT text support.</Description>
        <Authors>shy-ro</Authors>
        <PackageTags>nbt;minecraft;serialization;polytype;aot;snbt</PackageTags>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/shy-ro/Poly.NBT</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="PolyType" Version="1.4.1" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
