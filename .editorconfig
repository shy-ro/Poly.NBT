# EditorConfig for the Poly.NBT repository. See https://editorconfig.org.
#
# `dotnet format` reads these rules without any extra configuration, which is the point: without a file
# both it and any editor fall back to per-machine defaults, so the style cannot be enforced or reviewed.
# Keep every rule here in step with the code. A rule that disagrees with what is committed turns
# `dotnet format --verify-no-changes` into a diff on every build.

root = true

[*]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
# Line endings are deliberately left to Git's core.autocrlf rather than pinned here: the working tree is
# CRLF on Windows and LF elsewhere, and a rule that names one of them fails the format check on the other.

[*.{cs,csx}]
# Namespace and using style. Every file in the repository already uses a file-scoped namespace with the
# directives above it, and System.* first.
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# Language keywords over framework type names, and readonly where a field is never reassigned.
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning
dotnet_style_readonly_field = true:warning

# Only enforce the null-check shape the codebase already uses; the rest are recorded as preferences so a
# reader knows the house style without `dotnet format` rewriting code that is already idiomatic.
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:warning
dotnet_style_object_initializer = true:silent
dotnet_style_collection_initializer = true:silent
dotnet_style_coalesce_expression = true:silent
dotnet_style_null_propagation = true:silent
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_method = false:silent

csharp_style_var_for_built_in_types = false:silent
csharp_style_var_when_type_is_apparent = true:silent
csharp_style_var_elsewhere = false:silent
csharp_prefer_braces = true:silent
csharp_prefer_simple_using_statement = true:silent
csharp_style_expression_bodied_methods = when_on_single_line:silent
csharp_style_expression_bodied_operators = when_on_single_line:silent
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_constructors = false:silent
csharp_style_throw_expression = true:silent
csharp_style_pattern_matching_over_is_with_cast_check = true:silent
csharp_style_prefer_pattern_matching = true:silent
csharp_style_prefer_not_pattern = true:silent
csharp_style_prefer_extended_property_pattern = true:silent
csharp_style_prefer_primary_constructors = true:silent

# Analyzer severities. IDE0005 is raised to a warning so an unused using cannot survive a format check;
# the library targets AOT, where an unnecessary reference is also a trimmer hint worth removing.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.CA1822.severity = silent
dotnet_diagnostic.CA1051.severity = silent
dotnet_diagnostic.IDE0290.severity = silent
